#!/bin/sh

#
# Gradle wrapper bootstrap script
# Downloads the Gradle wrapper JAR if not present, then runs it.
#

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"

# Check if gradle wrapper JAR exists
if [ ! -f "$PROJECT_DIR/gradle/wrapper/gradle-wrapper.jar" ]; then
    echo "[*] Downloading Gradle wrapper..."
    GRADLE_VERSION="8.14.3"
    WRAPPER_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"

    mkdir -p "$PROJECT_DIR/gradle/wrapper"

    # Download the wrapper properties file is the real driver
    # The actual gradlew is complex. Use the gradle command if available.
    if command -v gradle >/dev/null 2>&1; then
        cd "$PROJECT_DIR" && gradle wrapper --gradle-version "$GRADLE_VERSION"
    else
        echo "[!] Gradle not installed. Options:"
        echo "    1. Open project in Android Studio (File > Open)"
        echo "    2. Install Gradle: sdk install gradle 8.14"
        echo "    3. Install SDKMAN: curl -s https://get.sdkman.io | bash"
        echo ""
        echo "    After Gradle is installed, run: gradle wrapper"
        exit 1
    fi
fi

# Execute the real gradlew
exec "$PROJECT_DIR/gradlew" "$@"
