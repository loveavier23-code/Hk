# ============================================================
#  Binance Futures Testnet — copy to backend/.env and fill in
#  NEVER commit your real .env file (it is gitignored).
# ============================================================

# Binance Futures API credentials
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here
BINANCE_BASE_URL=https://testnet.binancefuture.com
BINANCE_WS_URL=wss://stream.binancefuture.com

# TRADING_MODE:
#   auto  -> detect Binance reachability; LIVE if reachable else SIM  (default)
#   live  -> force real Binance Futures testnet trading
#   sim   -> force simulated market data + paper trading (no network needed)
TRADING_MODE=auto

# Symbols to trade (comma separated)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT

# Strategy: auto | ema_cross | rsi_momentum | macd | mean_reversion | grid
STRATEGY=auto

# Risk parameters
LEVERAGE=10
RISK_PER_TRADE_PCT=2.0
STOP_LOSS_PCT=2.5
TAKE_PROFIT_PCT=5.0
TRAILING_STOP_PCT=0.0
MAX_POSITIONS=3
MAX_DRAWDOWN_PCT=12.0

# Engine timing (seconds)
LOOP_INTERVAL_SIM=4
LOOP_INTERVAL_LIVE=12

# Server
HOST=0.0.0.0
PORT=8000
